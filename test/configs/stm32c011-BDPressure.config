# Base config for the BDPressure board using STM32C011.
# The onboard CH340 is wired to PA11/PA12 on T17/T18. Those pins use
# the STM32C0 software-serial backend.
# PA0/PA1 are not accessible on this board; user-accessible test pads are
# T5-T16.
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32C011=y
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_STM32_CLOCK_REF_INTERNAL=y
CONFIG_STM32_FLASH_START_0000=y
# CONFIG_STM32_SERIAL_USART1 is not set
# CONFIG_STM32_SERIAL_USART1_ALT_PA0_PA1 is not set
CONFIG_STM32_SERIAL_SOFT_PA12_PA11=y
CONFIG_SERIAL_BAUD=38400
CONFIG_INITIAL_PINS="PA8"
CONFIG_WANT_ADC=y
CONFIG_WANT_SPI=y
CONFIG_WANT_SOFTWARE_SPI=y
CONFIG_WANT_I2C=y
CONFIG_WANT_HARD_PWM=y
CONFIG_WANT_BUTTONS=y
CONFIG_WANT_ADXL345=y
CONFIG_WANT_ADS1220=y
CONFIG_WANT_TRIGGER_ANALOG=y
